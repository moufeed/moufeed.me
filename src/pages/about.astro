---
import Layout from "../layouts/Layout.astro"
import { site } from "../data/site"
import { copy } from "../data/copy"

const { about } = copy
---

<Layout title={about.pageTitle}>
  <div class="container about-page grid">
    <div class="about-page-wrapper">
      <header class="about-page--intro">
        <h1 class="about-page--title">{about.heading}</h1>
        <div class="about-page--info">
          {
            about.bio.map((paragraph) => (
              <p>
                {paragraph.map((part) =>
                  typeof part === "string" ? (
                    part
                  ) : (
                    <strong class="text-darken">{part.strong}</strong>
                  )
                )}
              </p>
            ))
          }
        </div>
      </header>

      <section class="skills" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="about-page--subtitle">
          {about.skillsHeading}
        </h2>
        <p class="skills--lede">{about.skillsLede}</p>

        <div class="skills--board">
          {
            about.skillGroups.map((group) => (
              <div class="skills--group">
                <h3 class="skills--group-title">{group.title}</h3>
                <ul class="skills--list">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <p class="skills--resume">
          <a
            rel="noreferrer"
            href={site.resumeUrl}
            target="_blank"
            class="btn btn-fill"
          >
            {about.resumeCta}
          </a>
        </p>
      </section>
    </div>
  </div>
</Layout>
