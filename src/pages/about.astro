---
import Layout from "../layouts/Layout.astro"
import { site } from "../data/site"
import { copy } from "../data/copy"

const { about } = copy
---

<Layout title={about.pageTitle}>
  <div class="container about-page grid">
    <div class="about-page-wrapper">
      <header class="about-page--intro">
        <h1 class="about-page--title">{about.heading}</h1>
        <div class="about-page--info">
          {
            about.bio.map((paragraph) => (
              <p>
                {paragraph.map((part) =>
                  typeof part === "string" ? (
                    part
                  ) : (
                    <strong class="text-darken">{part.strong}</strong>
                  )
                )}
              </p>
            ))
          }
        </div>
      </header>

      <section class="skills" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="about-page--subtitle">
          {about.skillsHeading}
        </h2>
        <p class="skills--lede">{about.skillsLede}</p>

        <div class="skills--board">
          {
            about.skillGroups.map((group) => (
              <div class="skills--group">
                <h3 class="skills--group-title">{group.title}</h3>
                <ul class="skills--list">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

      </section>

      <section class="about-block" aria-labelledby="education-heading">
        <h2 id="education-heading" class="about-page--subtitle">
          {about.educationHeading}
        </h2>
        <div class="about-block--body">
          <p class="about-block--lead">
            <strong>{about.education.degree}</strong> — {about.education.institution}
          </p>
          <p class="about-block--detail">{about.education.field}</p>
        </div>
      </section>

      <section class="about-block" aria-labelledby="certifications-heading">
        <h2 id="certifications-heading" class="about-page--subtitle">
          {about.certificationsHeading}
        </h2>
        <ul class="about-block--list list-style-none">
          {
            about.certifications.map((item) => (
              <li>
                <a href={item.url} target="_blank" rel="noreferrer">
                  <strong>{item.title}</strong>
                  {" — "}
                  {item.issuer}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="about-block" aria-labelledby="languages-heading">
        <h2 id="languages-heading" class="about-page--subtitle">
          {about.languagesHeading}
        </h2>
        <ul class="skills--list">
          {
            about.languages.map((lang) => (
              <li>
                {lang.name} — {lang.level}
              </li>
            ))
          }
        </ul>
      </section>

      <p class="skills--resume">
        <a
          rel="noreferrer"
          href={site.resumeUrl}
          target="_blank"
          class="btn btn-fill"
        >
          {about.resumeCta}
        </a>
      </p>
    </div>
  </div>
</Layout>
