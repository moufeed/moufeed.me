---
import Layout from "../layouts/Layout.astro"
import { site } from "../data/site"
import { copy } from "../data/copy"
---

<Layout title={site.contactLabel}>
  <div class="container contact-page">
    <div class="contact-page--panel">
      <h1 class="contact-page--title">{site.contactLabel}</h1>
      <p class="contact-page--lede">{copy.contact.lede}</p>

      <div class="contact-page--channels">
        <a
          class="contact-page--email btn btn-fill"
          href={`mailto:${site.email}?Subject=${encodeURIComponent(copy.contact.emailSubject)}`}
        >
          {site.email}
        </a>

        <ul class="contact-page--social list-style-none">
          {
            site.socialLinks.map((item) => (
              <li>
                <a href={item.url} target="_blank" rel="noreferrer">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`https://twitter.com/${site.author}`}
              target="_blank"
              rel="noreferrer"
            >
              {copy.contact.twitter}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
