---
import { site } from "../data/site"
import { copy } from "../data/copy"
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero--inner container">
    <p class="hero--role">{site.title}</p>
    <h1 id="hero-title" class="hero--title">
      {copy.home.greetingBefore}
      {" "}
      <span class="hero--name">{site.name}</span>
    </h1>
    <p class="hero--subtitle">{copy.home.subtitle}</p>
    <div class="hero--actions">
      {/* <a class="btn btn-fill" href="/portfolio">{copy.home.portfolioCta}</a> */}
      <a class="btn btn-fill" href={site.contactUrl}>{site.contactLabel}</a>
    </div>
  </div>
</section>
