---
import { site } from "../data/site"
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero--inner container">
    <p class="hero--role">{site.title}</p>
    <h1 id="hero-title" class="hero--title">
      Hello, my name is <span class="hero--name">{site.name}</span>
    </h1>
    <p class="hero--subtitle">
      Front-end developer with 6+ years building fast, clear websites. Based in
      Istanbul.
    </p>
    <div class="hero--actions">
      {/* <a class="btn btn-fill" href="/portfolio">View portfolio</a> */}
      <a class="btn btn-fill" href="/contacts">Contacts</a>
    </div>
  </div>
</section>
